# ==============================================================================
# Helpdesk Ticketing System - Unified Environment Configuration
# ==============================================================================

# Application Environment (development, production, test)
APP_NAME=helpdesk-ticketing-system
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=helpdesk_db
DB_SSLMODE=disable

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# JWT Authentication
# Note: In production (APP_ENV=production), JWT_SECRET must be explicitly set
# to a strong unique random secret of at least 32 characters.
JWT_SECRET=super_secret_jwt_key_helpdesk_change_in_production
JWT_EXPIRATION_HOURS=24

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080

# Automation on startup
AUTO_MIGRATE=true
AUTO_SEED=true

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
