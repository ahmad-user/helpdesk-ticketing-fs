# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME=helpdesk-ticketing-system
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=helpdesk_db
DB_SSLMODE=disable

# Database Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# ==============================================================================
# JWT Authentication Configuration
# In production (APP_ENV=production), JWT_SECRET must be explicitly configured
# with a secure random key of at least 32 characters (HMAC-SHA256).
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_helpdesk_change_in_production
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# CORS & Automation Configuration
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
AUTO_MIGRATE=true
AUTO_SEED=true
